    "@types/node": "^24.19.2",
    "@types/three": "0.183.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
